{
  "name": "savia-remote-control",
  "version": "1.0.0",
  "description": "S.A.V.I.A — Second Brain Remote Control: Telegram bot that parses natural-language commands via OpenRouter.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop savia-bot",
    "pm2:restart": "pm2 restart savia-bot",
    "pm2:logs": "pm2 logs savia-bot",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.5",
    "node-pty": "^1.1.0",
    "node-telegram-bot-api": "0.67.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/node-telegram-bot-api": "0.64.15",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
